---
import { chapters, courseUrl, lessonUrl } from '../course/content';
import '../styles/course.css';
interface Props { title: string; description?: string; chapterSlug?: string; lessonSlug?: string }
const { title, description = 'Conceptos, algoritmos y ejemplos guiados para el curso de Inteligencia Artificial.', chapterSlug, lessonSlug } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <title>{title} · Inteligencia artificial</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="course-header"><a class="course-name" href={courseUrl}>Inteligencia artificial</a><nav aria-label="Recursos del curso"><a href={courseUrl}>Índice</a><a href={`${courseUrl}referencias/`}>Referencias</a></nav></header>
    <div class="course-shell">
      <aside class="course-sidebar" aria-label="Contenido del curso">
        <details class="mobile-contents" open><summary>Contenido del curso</summary><nav aria-label="Capítulos y temas"><a class="overview-link" href={courseUrl}>Guía del curso</a>{chapters.map(chapter => <details class="chapter-group" open={chapter.slug === chapterSlug}><summary><span class="chapter-number">{chapter.number}</span><span>{chapter.title}</span></summary><ol><li><a href={`${courseUrl}${chapter.slug}/`} aria-current={chapter.slug === chapterSlug && !lessonSlug ? 'page' : undefined}>Presentación</a></li>{chapter.lessons.map(lesson => <li><a href={lessonUrl(chapter, lesson)} aria-current={chapter.slug === chapterSlug && lesson.slug === lessonSlug ? 'page' : undefined}>{lesson.title}</a></li>)}</ol></details>)}</nav><div class="sidebar-note">Conceptos y ejemplos organizados según las notas de clase.</div></details>
      </aside>
      <main id="contenido" class="course-main"><slot /></main>
    </div>
    <footer class="course-footer"><span>Inteligencia artificial · Guía de estudio</span><a href={`${courseUrl}referencias/`}>Fuentes y atribuciones</a></footer>
    <script>
      const contents = document.querySelector<HTMLDetailsElement>('.mobile-contents');
      const media = window.matchMedia('(max-width: 760px)');
      const adapt = () => { if (contents) contents.open = !media.matches; };
      adapt(); media.addEventListener('change', adapt);
    </script>
  </body>
</html>
